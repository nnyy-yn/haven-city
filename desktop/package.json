{
  "name": "haven-city-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "栖湾市 · 离线城市与居民生活模拟",
  "author": "Haven City",
  "main": "main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --config electron-builder.cjs --dir --win --x64 --publish never",
    "build:win": "electron-builder --config electron-builder.cjs --win nsis portable --x64 --publish never",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": { "electron-updater": "6.8.9" },
  "devDependencies": { "electron": "44.9.0", "electron-builder": "26.15.3" }
}
